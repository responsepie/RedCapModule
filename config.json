{
  "name": "ResponsePie for REDCap",
  "namespace": "Ossillate\\ResponsePieRedcap",
  "framework-version": 14,
  "description": "Loads ResponsePie on every public REDCap survey page in an enabled project using the one-line JavaScript embed code supplied by ResponsePie.",
  "documentation": "README.md",
  "authors": [
    {
      "name": "Ossillate, Inc."
    }
  ],
  "compatibility": {
    "redcap-version-min": "10.0.0",
    "php-version-min": "7.2"
  },
  "project-settings": [
    {
      "key": "rp-embed-code",
      "name": "ResponsePie one-line JavaScript embed code",
      "type": "textarea",
      "required": true
    }
  ]
}
